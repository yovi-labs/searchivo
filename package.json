{
  "name": "searchivo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node scripts/boundaries.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "benchmark": "node --expose-gc benchmarks/run.mjs",
    "bundle": "node scripts/bundle.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test && pnpm boundaries && pnpm validate:package && pnpm bundle"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
