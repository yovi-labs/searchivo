{
  "name": "searchivo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node scripts/boundaries.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "benchmark": "node --expose-gc benchmarks/run.mjs",
    "bundle": "node scripts/bundle.mjs",
    "check": "pnpm format:check && pnpm build && pnpm test && pnpm boundaries && pnpm validate:package && pnpm bundle"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "prettier": "3.9.10",
    "esbuild": "0.28.2"
  }
}
