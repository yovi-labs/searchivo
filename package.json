{
  "name": "searchivo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "docs:links": "node scripts/check-repo-links.mjs",
    "preview:website": "node scripts/serve.mjs dist/website 4174",
    "build:website": "tsc -p apps/website/tsconfig.json && tsc -p apps/playground/tsconfig.worker.json && node scripts/build-site.mjs && node scripts/check-site.mjs",
    "build": "tsc -b && pnpm build:angular",
    "build:angular": "ng-packagr -p packages/angular/ng-package.json -c packages/angular/tsconfig.json",
    "build:example": "ng build example && node scripts/build-worker-example.mjs",
    "benchmark:workers": "node benchmarks/workers.mjs",
    "test:browser": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node scripts/boundaries.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "benchmark": "node --expose-gc benchmarks/run.mjs",
    "bundle": "node scripts/bundle.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test && pnpm boundaries && pnpm validate:package && pnpm bundle && pnpm docs:links"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "marked": "18.1.2",
    "ng-packagr": "22.2.5",
    "prettier": "3.9.10",
    "rxjs": "7.8.2",
    "sass": "1.106.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
