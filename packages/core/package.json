{
  "name": "@searchivo/core",
  "version": "0.1.0-rebuild.0",
  "private": true,
  "description": "Fast search. Simple API. Framework-independent typed search.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./suggestions": {
      "types": "./dist/suggestions.d.ts",
      "import": "./dist/suggestions.js"
    },
    "./refinements": {
      "types": "./dist/refinements.d.ts",
      "import": "./dist/refinements.js"
    },
    "./fuzzy": {
      "types": "./dist/fuzzy.d.ts",
      "import": "./dist/fuzzy.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "import": "./dist/highlight.js"
    },
    "./bm25": {
      "types": "./dist/bm25.d.ts",
      "import": "./dist/bm25.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yovi-labs/searchivo.git",
    "directory": "packages/core"
  }
}
